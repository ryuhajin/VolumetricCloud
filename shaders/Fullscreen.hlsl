// ============================================================================
//  Fullscreen.hlsl  —  풀스크린 삼각형 정점 셰이더
// ----------------------------------------------------------------------------
//  정점 버퍼 없이 SV_VertexID(0,1,2) 만으로 화면 전체를 덮는 거대한 삼각형
//  하나를 생성한다. 픽셀 셰이더(VolumetricClouds.hlsl)는 이 삼각형 위에서
//  픽셀마다 실행되며 uv를 받아 카메라 레이를 만든다.
//
//  Draw 호출: context->Draw(3, 0);  (정점 3개, 입력 레이아웃 불필요)
// ============================================================================

struct VSOut
{
    float4 pos : SV_POSITION; // 클립 공간 위치
    float2 uv  : TEXCOORD0;   // 화면 [0,1] 좌표 (좌상단 0,0 / 우하단 1,1)
};

VSOut main(uint id : SV_VertexID)
{
    VSOut o;

    // id=0 -> (0,0), id=1 -> (2,0), id=2 -> (0,2)
    // 화면을 덮는 [0,2] 범위 삼각형. 보이는 영역은 [0,1]x[0,1].
    o.uv = float2((id << 1) & 2, id & 2);

    // uv(0,0)->좌상단(-1,1), uv(1,1)->우하단(1,-1)
    o.pos = float4(o.uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);

    return o;
}
